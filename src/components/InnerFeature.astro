---
import source from '../data/original.json';
const {route}=Astro.props;
const page=(source as any)[route];
const isProject=route.startsWith('/projects/');
const project=source['/projects'].projects.find(p=>p.href===route);
const split=(html:string)=>html.split(/(?=<h[23][ >])/).filter(part=>part.replace(/<[^>]+>/g,'').trim());
const story=isProject?page.blocks.slice(1).flatMap(split):[];
const sections=[];
for(let i=0;i<story.length;i+=3) sections.push(story.slice(i,i+3).join(''));
const images=page.images||[];
const inlineImages=isProject?images.slice(1,Math.min(sections.length+1,images.length)):[];
const processSteps=route==='/our-process'?split(page.blocks[1]):[];
---
{isProject ? <>
<section class="project-opening"><img src={images[0]?.url||'/images/2.jpg'} alt={`${project?.name} project by AB Bespoke Home`} fetchpriority="high"/><div class="opening-caption wrap"><a href="/projects" class="eyebrow">FEATURED PROJECTS</a><h1>{project?.name}</h1></div></section>
<div class="project-narrative wrap">{sections.map((html,i)=><section class:list={['story-chapter',i%2===1&&'reverse',!inlineImages[i]&&'text-only']}><article class="prose reveal" set:html={html}/>{inlineImages[i]&&<button class="project chapter-photo reveal" data-image={inlineImages[i].url} data-title={project?.name} aria-label={`Enlarge ${project?.name} photo ${i+2}`}><img src={inlineImages[i].url} alt={`${project?.name} project, photo ${i+2}`} loading="lazy"/><span class="photo-expand" aria-hidden="true">＋</span></button>}</section>)}</div>
{images.length>inlineImages.length+1&&<section class="project-gallery wrap" aria-label={`${project?.name} gallery`}>{images.slice(inlineImages.length+1).map((im:any,i:number)=><button class="project reveal" data-image={im.url} data-title={project?.name} aria-label={`Enlarge ${project?.name} gallery photo ${i+1}`}><div class="photo"><img src={im.url} alt={`${project?.name} project detail`} loading="lazy"/></div></button>)}</section>}
<div class="wrap related project-next">{source['/projects'].projects.filter(p=>p.href!==route).map(p=><a class="text-link" href={p.href}>{p.name}<span aria-hidden="true">→</span></a>)}</div>
</> : route==='/meet-the-team' ? <>
<section class="about-opening wrap"><div class="reveal"><p class="eyebrow">AB BESPOKE HOME</p><h1>{page.texts[0]}</h1><div class="prose" set:html={page.blocks[1]}/></div><figure><img src="/images/team0.jpg" alt="Aaron and Allison Byrne, AB Bespoke Home" fetchpriority="high"/></figure></section>
<section class="owner-story wrap"><div class="owner-portrait"><img src="/images/team1.jpg" alt="Aaron Byrne, owner of AB Bespoke Home" loading="lazy"/></div><div><div class="owner-title reveal" set:html={page.blocks[2]}/>{page.blocks.slice(3,6).map((html:string,i:number)=><article class="biography-part prose reveal"><span class="chapter-index" aria-hidden="true">0{i+1}</span><div set:html={html}/></article>)}</div></section><section class="wrap about-close prose" set:html={page.blocks[6]}/>
</> : route==='/our-process' ? <>
<section class="process-opening wrap reveal"><p class="eyebrow">OUR PROCESS</p><h1>{page.texts[0]}</h1></section><div class="process-banner wrap"><img src="/images/6.jpg" alt="AB Bespoke Home kitchen project" fetchpriority="high"/></div>
<section class="timeline-layout wrap"><aside><p class="eyebrow">OUR PROCESS</p><nav class="step-index" aria-label="Process steps">{processSteps.map((html:string,i:number)=><a href={`#process-${i+1}`}><span>0{i+1}</span>{html.match(/<h[23][^>]*>(.*?)<\/h[23]>/s)?.[1].replace(/<[^>]+>/g,'')}</a>)}</nav></aside><div class="process-timeline">{processSteps.map((html:string,i:number)=><article id={`process-${i+1}`} class="timeline-step"><span class="timeline-number">0{i+1}</span><div class="prose reveal" set:html={html}/></article>)}</div></section><div class="wrap process-blog prose" set:html={page.blocks[2]}/>
</> : route==='/signature-guarantee' ? <>
<section class="guarantee-opening wrap reveal"><p class="eyebrow">SIGNATURE GUARANTEE</p><h1>{page.texts[0]}</h1></section><section class="guarantee-promise"><div class="wrap promise-grid"><div class="promise-number" aria-hidden="true">3<span>%</span></div><div class="prose reveal"><div set:html={page.blocks[1]}/><div set:html={page.blocks[2]}/></div></div></section><section class="guarantee-explanation wrap"><img src="/images/1.jpg" alt="Custom wood detail in an AB Bespoke Home project" loading="lazy"/><article class="prose reveal" set:html={page.blocks[3]}/></section><section class="guarantee-steps wrap"><p class="eyebrow">{page.texts[4]}</p><div class="reveal" set:html={page.blocks[5]}/><div class="guarantee-step-grid">{[6,8,10].map(i=><article class="prose reveal"><div set:html={page.blocks[i]}/><div set:html={page.blocks[i+1]}/></article>)}</div></section><figure class="guarantee-quote wrap reveal"><blockquote set:html={page.blocks[12]}/><figcaption set:html={page.blocks[13]}/></figure>
</> : null}
