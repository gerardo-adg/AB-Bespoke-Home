---
import source from '../data/original.json';
import Arrow from './Arrow.astro';
import BrandSeal from './BrandSeal.astro';
const {route}=Astro.props;
const page=(source as any)[route];
const project=source['/projects'].projects.find(p=>p.href===route);
const split=(html:string)=>html.split(/(?=<h[23][ >])/).filter(part=>part.replace(/<[^>]+>/g,'').trim());
const heading=(html:string)=>html.match(/<h[23][^>]*>(.*?)<\/h[23]>/s)?.[1].replace(/<[^>]+>/g,'')||'';
const withoutHeading=(html:string)=>html.replace(/<h[23][^>]*>.*?<\/h[23]>/s,'');
const images=page.images||[];
const story=project?page.blocks.slice(2).flatMap(split):[];
const processSteps=route==='/our-process'?split(page.blocks[1]):[];
const chapterItems=story.map((html:string,i:number)=>({html,image:i>0&&i%3===1?images[2+Math.floor(i/3)]:null}));
const gallery=images.slice(2+Math.ceil(Math.max(story.length-1,0)/3));
const related=source['/projects'].projects.filter(p=>p.href!==route).slice(0,2);
---
<div class="studio">
{project ? <>
<section class="case-cover studio-wrap"><div class="case-heading"><a class="studio-label" href="/projects"><Arrow direction="back"/> FEATURED PROJECTS</a><h1>{project.name}</h1><div class="case-description" set:html={page.blocks[1]}/><a class="studio-link" href="#project-story">Explore the Project <Arrow direction="down"/></a></div><button class="case-lead project" data-image={images[0]?.url} data-title={project.name} aria-label={`Enlarge ${project.name} main photo`}><img src={images[0]?.url||'/images/2.jpg'} alt={`${project.name} by AB Bespoke Home`} fetchpriority="high"/><span aria-hidden="true">+</span></button>{images[1]&&<button class="case-detail project" data-image={images[1].url} data-title={project.name} aria-label={`Enlarge ${project.name} detail photo`}><img src={images[1].url} alt={`${project.name} project detail`} loading="eager"/><span aria-hidden="true">+</span></button>}</section>
<section class="studio-wrap case-story" id="project-story"><aside><p class="studio-label">THE PROJECT / {project.name}</p><nav aria-label="Project chapters">{story.map((html:string,i:number)=>heading(html)&&<a href={`#chapter-${i}`}>{heading(html)}</a>)}</nav></aside><div class="case-chapters">{chapterItems.map(({html,image}:any,i:number)=><article class="case-chapter" id={`chapter-${i}`}><div class="prose" set:html={html}/>{image && (<button class="project chapter-inset" data-image={image.url} data-title={project.name} aria-label={`Enlarge ${project.name} story photo ${i}`}><img src={image.url} alt={`${project.name} interior detail`} loading="lazy"/><span aria-hidden="true">+</span></button>)}</article>)}</div></section>
<section class="studio-wrap case-gallery" aria-label={`${project.name} gallery`}>{gallery.map((im:any,i:number)=><button class="project" data-image={im.url} data-title={project.name} aria-label={`Enlarge ${project.name} gallery photo ${i+1}`}><img src={im.url} alt={`${project.name} project detail`} loading="lazy"/><span aria-hidden="true">+</span></button>)}</section>
<section class="studio-wrap case-related"><p class="studio-label">CONTINUE EXPLORING</p><div>{related.map(p=><a href={p.href}><img src={(source as any)[p.href].images[0].url} alt={`${p.name} project`} loading="lazy"/><h2>{p.name} <Arrow/></h2></a>)}</div></section>
</> : route==='/meet-the-team' ? <>
<section class="profile-cover studio-wrap"><div class="profile-heading"><p class="studio-label">AB BESPOKE HOME / THE PEOPLE</p><h1>{page.texts[0]}</h1></div><figure class="profile-photo"><img src="/images/team0.jpg" alt="Aaron and Allison Byrne" fetchpriority="high"/><figcaption>AB BESPOKE HOME · SACRAMENTO, CA</figcaption></figure><div class="profile-intro prose" set:html={page.blocks[1]}/></section>
<section id="owner" class="owner-profile layered-owner"><BrandSeal/><div class="studio-wrap"><div class="owner-heading" set:html={page.blocks[2]}/><div class="owner-composition"><figure class="owner-photo-pair"><img class="owner-main-photo reveal" src="/images/team1.jpg" alt="Aaron Byrne, owner of AB Bespoke Home" loading="lazy"/><img class="owner-work-inset reveal" data-reveal-delay="120" src="/images/6.jpg" alt="Kitchen remodel by AB Bespoke Home" loading="lazy"/><figcaption>AARON BYRNE / OWNER</figcaption></figure><div class="owner-biography">{page.blocks.slice(3,6).map((html:string,i:number)=><article><span class="studio-index">0{i+1}</span><div class="prose" set:html={html}/></article>)}</div></div></div></section><div class="studio-wrap profile-close prose" set:html={page.blocks[6]}/>
</> : route==='/our-process' ? <>
<section class="process-studio"><div class="studio-wrap process-stage"><div><p class="studio-label">AB BESPOKE HOME / HOW WE WORK</p><h1>{page.texts[0]}</h1></div><img src="/images/6.jpg" alt="AB Bespoke Home kitchen project" fetchpriority="high"/><nav class="process-map" aria-label="Process steps">{processSteps.map((html:string,i:number)=><a href={`#process-${i+1}`}><span>0{i+1}</span>{heading(html)}<Arrow direction="down"/></a>)}</nav></div></section>
<section class="studio-wrap process-path">{processSteps.map((html:string,i:number)=><article id={`process-${i+1}`} class="process-station timeline-step"><div class="station-marker"><span>0{i+1}</span><div aria-hidden="true"></div></div><div class="prose" set:html={html}/></article>)}</section><div class="studio-wrap process-reading prose" set:html={page.blocks[2]}/>
</> : <>
<section class="guarantee-cover studio-wrap"><div class="guarantee-head"><p class="studio-label">AB BESPOKE HOME / SIGNATURE GUARANTEE</p><h1>{page.texts[0]}</h1></div><div class="guarantee-seal"><span class="seal-number" aria-hidden="true">3<span>%</span></span><div class="prose"><div set:html={page.blocks[1]}/><div set:html={page.blocks[2]}/></div></div><div class="guarantee-note prose" set:html={page.blocks[3]}/><div class="guarantee-detail"><img src="/images/1.jpg" alt="AB Bespoke Home custom wood detail" loading="lazy"/></div></section>
<section class="clarity-studio"><div class="studio-wrap"><div class="clarity-heading"><p class="studio-label">{page.texts[4]}</p><div set:html={page.blocks[5]}/></div><div class="clarity-steps">{[6,8,10].map((i,n)=><article><span class="clarity-count" aria-hidden="true">0{n+1}</span><div class="prose"><div set:html={page.blocks[i]}/><div set:html={page.blocks[i+1]}/></div></article>)}</div></div></section><figure class="studio-wrap studio-quote"><span aria-hidden="true">“</span><blockquote set:html={page.blocks[12]}/><figcaption set:html={page.blocks[13]}/></figure>
</>}
</div>
