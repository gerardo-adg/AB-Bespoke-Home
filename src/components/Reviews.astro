---
import source from '../data/original.json';
import Arrow from './Arrow.astro';
const reviews=source['/'].testimonials;
---
<section class="review-carousel wrap" id="reviews" aria-labelledby="review-heading" aria-roledescription="carousel" data-review-carousel>
 <div class="review-heading"><p class="eyebrow" id="review-heading">CLIENT EXPERIENCES</p><span class="review-heading-line" aria-hidden="true"></span></div>
 <span class="review-quote-mark" aria-hidden="true">“</span>
 <div class="review-track" id="review-track" tabindex="0" aria-label="Client reviews. Use left and right arrow keys to browse." data-review-track>
 {reviews.map((review,i)=><figure class="review-slide" role="group" aria-roledescription="slide" aria-label={`Review ${i+1} of ${reviews.length}`}><blockquote>{review.quote}</blockquote><figcaption>— {review.by}</figcaption></figure>)}
 </div>
 <div class="review-controls" data-review-controls hidden><button type="button" class="review-arrow previous" data-review-prev aria-label="Previous review" aria-controls="review-track" disabled><Arrow direction="back"/></button><div class="review-position"><div class="review-dots" aria-label="Choose a review">{reviews.map((review,i)=><button type="button" data-review-dot={i} aria-label={`Show review by ${review.by}`} aria-current={i===0?'true':undefined}><span></span></button>)}</div><span class="review-count" data-review-count aria-live="polite" aria-atomic="true">01 / 0{reviews.length}</span></div><button type="button" class="review-arrow next" data-review-next aria-label="Next review" aria-controls="review-track"><Arrow direction="back"/></button></div>
</section>
<script>
document.querySelectorAll<HTMLElement>('[data-review-carousel]').forEach(carousel=>{
 const track=carousel.querySelector<HTMLElement>('[data-review-track]')!;
 const slides=Array.from(track.querySelectorAll<HTMLElement>('.review-slide'));
 const previous=carousel.querySelector<HTMLButtonElement>('[data-review-prev]')!;
 const next=carousel.querySelector<HTMLButtonElement>('[data-review-next]')!;
 const dots=Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-review-dot]'));
 const count=carousel.querySelector<HTMLElement>('[data-review-count]')!;
 let current=0;
 const update=(index:number)=>{
  if(index===current && carousel.hasAttribute('data-reviews-ready'))return;
  current=index;previous.disabled=index===0;next.disabled=index===slides.length-1;
  dots.forEach((dot,i)=>{if(i===index)dot.setAttribute('aria-current','true');else dot.removeAttribute('aria-current');});
  count.textContent=`${String(index+1).padStart(2,'0')} / ${String(slides.length).padStart(2,'0')}`;
 };
 const move=(index:number)=>{
  const target=Math.max(0,Math.min(slides.length-1,index));
  track.scrollTo({left:target*track.clientWidth,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
 };
 previous.addEventListener('click',()=>move(current-1));next.addEventListener('click',()=>move(current+1));dots.forEach((dot,i)=>dot.addEventListener('click',()=>move(i)));
 track.addEventListener('keydown',event=>{if(event.key==='ArrowRight'){event.preventDefault();move(current+1)}else if(event.key==='ArrowLeft'){event.preventDefault();move(current-1)}else if(event.key==='Home'){event.preventDefault();move(0)}else if(event.key==='End'){event.preventDefault();move(slides.length-1)}});
 let settle:ReturnType<typeof setTimeout>;
 const sync=()=>update(Math.max(0,Math.min(slides.length-1,Math.round(track.scrollLeft/track.clientWidth))));
 track.addEventListener('scroll',()=>{clearTimeout(settle);settle=setTimeout(sync,120)},{passive:true});track.addEventListener('scrollend',sync);
 new ResizeObserver(()=>{track.scrollTo({left:current*track.clientWidth,behavior:'instant'})}).observe(track);
 update(0);carousel.setAttribute('data-reviews-ready','');carousel.querySelector<HTMLElement>('[data-review-controls]')!.hidden=false;
});
</script>
<style>
.review-carousel{padding:65px 0 75px;scroll-margin-top:30px}.review-heading{display:flex;align-items:center;gap:35px}.review-heading .eyebrow{margin:0;font-size:9px;white-space:nowrap}.review-heading-line{height:1px;background:var(--line);flex:1}.review-quote-mark{font-family:Georgia,serif;display:block;font-size:110px;color:#a7b194;text-align:center;height:88px;line-height:1.1;margin-top:30px}.review-track{display:flex;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;scrollbar-width:thin;align-items:stretch}.review-carousel[data-reviews-ready] .review-track{scrollbar-width:none}.review-carousel[data-reviews-ready] .review-track::-webkit-scrollbar{display:none}.review-slide{flex:0 0 100%;min-width:0;margin:0;padding:8px 9% 30px;scroll-snap-align:start;scroll-snap-stop:always;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:240px}.review-slide blockquote{font-family:Manrope,sans-serif;font-size:clamp(26px,3.2vw,43px);font-weight:400;line-height:1.5;letter-spacing:-1.2px;margin:0;max-width:950px;text-wrap:balance}.review-slide figcaption{font-size:11px;color:#737d67;margin-top:25px;letter-spacing:.3px}.review-controls{display:flex;align-items:center;justify-content:center;gap:30px;margin-top:8px}.review-controls[hidden]{display:none}.review-arrow{width:48px;height:48px;border:1px solid #bcc6ae;border-radius:50%;background:transparent;color:var(--ink);display:grid;place-items:center;cursor:pointer;transition:background-color .25s,opacity .25s}.review-arrow.next :global(svg){transform:rotate(180deg)}.review-arrow :global(svg){width:19px;height:19px}.review-arrow:hover:not(:disabled){background:#e3e8d9}.review-arrow:disabled{opacity:.3;cursor:default}.review-position{display:flex;align-items:center;gap:20px}.review-dots{display:flex;gap:0}.review-dots button{padding:0;width:30px;height:44px;border:0;background:none;cursor:pointer;display:grid;place-items:center}.review-dots button>span{width:5px;height:5px;border-radius:50%;background:#bfc7b3;transition:background-color .25s,transform .25s}.review-dots button[aria-current=true]>span{background:var(--ink);transform:scale(1.4)}.review-count{font-size:9px;letter-spacing:1.2px;color:#7f8b71;min-width:45px}.review-track:focus-visible,.review-carousel button:focus-visible{outline:2px solid #879875;outline-offset:4px}.review-carousel+.services{margin-top:0}
@media(max-width:800px){.review-carousel{padding:38px 0 45px}.review-heading{gap:22px}.review-heading .eyebrow{font-size:8px}.review-quote-mark{font-size:90px;height:70px;margin-top:24px}.review-slide{padding:10px 7px 22px;min-height:275px;justify-content:center}.review-slide blockquote{font-size:clamp(23px,6.2vw,29px);letter-spacing:-.6px;line-height:1.55}.review-slide figcaption{font-size:11px;margin-top:25px}.review-controls{gap:22px;margin-top:5px}.review-position{gap:12px}.review-arrow{width:44px;height:44px}.review-dots button{width:26px}.review-count{font-size:8px;min-width:40px}}
@media(prefers-reduced-motion:reduce){.review-arrow,.review-dots button>span{transition:none}}
</style>
