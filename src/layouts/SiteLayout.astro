---
import '../styles/site.css';
const {title='AB Bespoke Home', home=false}=Astro.props;
const services=[['Kitchens','/services/kitchen'],['Bathrooms','/services/bathrooms'],['Home Additions','/services/additions'],['Remodels','/services/remodels'],['New Construction','/services/new-construction']];
const about=[['Meet The Team','/meet-the-team'],['Our Process','/our-process'],['Services','/our-services'],['Signature Guarantee','/signature-guarantee'],['Whole-Home Remodel','/plan-whole-home-remodel']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><meta name="description" content="Luxury remodels, additions, & new construction in Sacramento. AB Bespoke Home."/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"/></head><body class:list={[!home && 'inner-page']}><a class="skip" href="#main">Skip to content</a><header><a href="/" class="logo" aria-label="AB Bespoke Home"><img src="/images/0.png" alt="AB Bespoke Home"/></a><nav id="navigation" aria-label="Main navigation"><details><summary>Services</summary><div class="dropdown">{services.map(([name,href])=><a href={href}>{name}</a>)}</div></details><a href="/projects">Featured Projects</a><details><summary>About</summary><div class="dropdown">{about.map(([name,href])=><a href={href}>{name}</a>)}</div></details><a href="https://blog.ab-bespoke.com/">Insights</a><a class="nav-cta" href="/contact">Start Building <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></nav><button class="menu" aria-label="Open navigation" aria-expanded="false" aria-controls="navigation">Menu <span>＋</span></button></header><main id="main"><slot/></main><footer class="wrap"><a class="footer-logo" href="/"><img src="/images/0.png" alt="AB Bespoke Home"/></a><p>YOUR HOME, BUILT TO SUIT<br/><span>Sacramento, California</span></p><div><a href="mailto:aaron@ab-bespoke.com">aaron@ab-bespoke.com</a><a href="tel:+19164000357">(916) 400-0357</a></div><div class="footer-links">{[...services,...about,['Featured Projects','/projects'],['Contact','/contact']].map(([name,href])=><a href={href}>{name}</a>)}</div><div class="footer-bottom"><span>© {new Date().getFullYear()} AB Bespoke Home</span><a href="#">Back to top ↑</a></div></footer><dialog id="gallery"><button class="close" aria-label="Close image">Close ×</button><img src="" alt=""/><p></p></dialog><script src="../scripts/site.ts"></script></body></html>
