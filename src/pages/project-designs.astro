---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import source from '../data/original.json';
const projects=source['/projects'].projects;
const selected=[projects[0],projects[1],projects[3]];
const photo=(p:any)=>(source as any)[p.href].images[0].url;
const subtitle=(p:any)=>{const block=(source as any)[p.href].blocks[1];return (block.match(/<h[1-6][^>]*>(.*?)<\/h[1-6]>/s)?.[1]||'').replace(/<[^>]*>/g,'').replace(/&amp;/g,'&');};
const options=[['Editorial gallery','A deliberate mix of photo sizes and generous space.'],['Project index','A compact list with a changing project photograph.'],['Photo gallery','Immersive photography with quiet captions.']];
---
<SiteLayout title="Featured Projects — Design Options | AB Bespoke Home">
<div class="design-workspace">
 <div class="design-picker"><div class="picker-heading"><a href="/">AB BESPOKE HOME</a><span>FEATURED PROJECTS / DESIGN STUDY</span></div><div class="option-tabs" role="tablist" aria-label="Project section design">{options.map(([name],i)=><button type="button" role="tab" id={`option-tab-${i}`} aria-controls={`option-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-option={i}><span>0{i+1}</span>{name}</button>)}</div><p class="option-description" id="option-description">{options[0][1]}</p></div>
 <section class="design-panel editorial-option" id="option-panel-0" role="tabpanel" aria-labelledby="option-tab-0" tabindex="0"><div class="option-wrap"><div class="editorial-heading"><div><span class="section-kicker">SELECTED WORK / AB BESPOKE HOME</span><h1>Featured Projects</h1></div><a class="all-projects" href="/projects">View Our Work <Arrow/></a></div><div class="editorial-grid">{selected.map((p,i)=><a href={p.href} class={`editorial-card editorial-card-${i}`}><div class="editorial-photo"><img src={photo(p)} alt={`${p.name} project by AB Bespoke Home`} loading={i===0?'eager':'lazy'}/><span class="project-open"><Arrow/></span></div><div class="editorial-caption"><span>0{i+1}</span><h2>{p.name}</h2><span class="caption-action">View Project</span></div>{i===0&&<p class="project-subtitle">{subtitle(p)}</p>}</a>)}</div></div></section>
 <section class="design-panel index-option" id="option-panel-1" role="tabpanel" aria-labelledby="option-tab-1" tabindex="0" hidden><div class="option-wrap"><div class="index-heading"><span class="section-kicker">SELECTED WORK / AB BESPOKE HOME</span><h1>Featured<br/> Projects</h1><a class="all-projects" href="/projects">View Our Work <Arrow/></a></div><div class="index-composition"><div class="index-preview" aria-hidden="true">{selected.map((p,i)=><img src={photo(p)} alt="" class:list={[i===0&&'is-active']} data-preview={i}/>)}</div><div class="project-index">{selected.map((p,i)=><a href={p.href} data-index={i} class:list={[i===0&&'is-active']}><span class="index-number">0{i+1}</span><div><h2>{p.name}</h2><p>{subtitle(p)}</p></div><img class="index-thumb" src={photo(p)} alt={`${p.name} project`} loading="lazy"/><Arrow/></a>)}</div></div></div></section>
 <section class="design-panel immersive-option" id="option-panel-2" role="tabpanel" aria-labelledby="option-tab-2" tabindex="0" hidden><div class="option-wrap"><div class="immersive-heading"><span class="section-kicker">SELECTED WORK / AB BESPOKE HOME</span><h1>Featured Projects</h1><a class="all-projects" href="/projects">View Our Work <Arrow/></a></div><div class="immersive-grid">{selected.map((p,i)=><a href={p.href} class={`immersive-card immersive-card-${i}`}><img src={photo(p)} alt={`${p.name} project by AB Bespoke Home`} loading="lazy"/><div class="immersive-caption"><span>0{i+1} / AB BESPOKE HOME</span><h2>{p.name}</h2><div class="immersive-bottom"><p>{subtitle(p)}</p><span class="project-open"><Arrow/></span></div></div></a>)}</div></div></section>
</div>
<script define:vars={{descriptions:options.map(o=>o[1])}}>
 const tabs=Array.from(document.querySelectorAll('[data-option]'));
 const panels=Array.from(document.querySelectorAll('.design-panel'));
 function choose(index,focus=false){tabs.forEach((t,i)=>{t.setAttribute('aria-selected',String(i===index));t.tabIndex=i===index?0:-1});panels.forEach((p,i)=>p.hidden=i!==index);document.querySelector('#option-description').textContent=descriptions[index];if(focus)tabs[index].focus();}
 tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>choose(index));tab.addEventListener('keydown',e=>{let next=index;if(e.key==='ArrowRight')next=(index+1)%tabs.length;else if(e.key==='ArrowLeft')next=(index+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();choose(next,true);});});
 const initial=Number(new URL(location.href).searchParams.get('option'));if(Number.isInteger(initial)&&initial>=0&&initial<tabs.length)choose(initial);
 const rows=Array.from(document.querySelectorAll('[data-index]'));
 function preview(index){rows.forEach((r,i)=>r.classList.toggle('is-active',i===index));document.querySelectorAll('[data-preview]').forEach((im,i)=>im.classList.toggle('is-active',i===index));}
 rows.forEach((row,index)=>{row.addEventListener('mouseenter',()=>preview(index));row.addEventListener('focus',()=>preview(index));});
</script>
<style>
.design-workspace{background:var(--paper)}.design-picker{padding:28px 7% 22px;background:#e5e8dd;border-bottom:1px solid #cbd1be}.picker-heading{display:flex;justify-content:space-between;gap:25px;font-size:9px;letter-spacing:1.5px;margin-bottom:22px}.option-tabs{display:flex;gap:10px}.option-tabs button{background:transparent;border:1px solid #adb6a1;min-height:48px;display:flex;align-items:center;gap:17px;font-size:12px;padding:12px 22px;cursor:pointer;color:var(--ink)}.option-tabs button>span{font-size:9px;opacity:.6}.option-tabs button[aria-selected=true]{background:var(--ink);color:var(--paper);border-color:var(--ink)}.option-description{font-size:12px;color:#69755e;margin-top:17px}.design-panel[hidden]{display:none!important}.design-panel{padding:75px 0 90px;outline:none}.option-wrap{width:86%;max-width:1450px;margin:auto}.section-kicker{font-size:9px;letter-spacing:1.7px;display:block;margin-bottom:22px}.design-panel h1{font-size:clamp(48px,5.7vw,84px);letter-spacing:-3px;line-height:1.1;max-width:none}.design-panel h2{font-size:29px;letter-spacing:-1px}.all-projects{display:inline-flex;gap:35px;min-height:44px;align-items:center;border-bottom:1px solid #a8b09b;font-size:12px}.editorial-heading{display:flex;justify-content:space-between;gap:35px;align-items:flex-end;margin-bottom:45px}.editorial-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:36px 50px;align-items:start}.editorial-card-0{grid-column:1;grid-row:1/3}.editorial-card-1{grid-column:2;grid-row:1}.editorial-card-2{grid-column:2;grid-row:2}.editorial-photo{position:relative;overflow:hidden}.editorial-photo img{height:260px;transition:transform .7s}.editorial-card-0 .editorial-photo img{height:620px}.project-open{width:44px;height:44px;background:var(--paper);color:var(--ink);display:grid;place-items:center}.editorial-photo .project-open{position:absolute;right:18px;bottom:18px}.editorial-caption{display:flex;align-items:center;gap:17px;margin-top:16px}.editorial-caption>span:first-child{font-size:9px;color:#849076}.editorial-caption h2{flex:1}.caption-action{font-size:9px}.project-subtitle{font-size:12px;color:#737f67;margin:12px 0 0 29px;max-width:380px}.editorial-card:hover img,.immersive-card:hover>img{transform:scale(1.025)}
.index-option{background:#e9ebdf}.index-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:35px;margin-bottom:45px}.index-heading>.section-kicker{align-self:flex-start;max-width:180px}.index-heading h1{margin-right:auto}.index-composition{display:grid;grid-template-columns:.95fr 1.1fr;gap:8%;align-items:center}.index-preview{height:540px;position:relative;overflow:hidden}.index-preview img{position:absolute;inset:0;height:100%;opacity:0;transition:opacity .4s;object-fit:cover}.index-preview img.is-active{opacity:1}.project-index>a{display:grid;grid-template-columns:25px 1fr 20px;gap:18px;border-top:1px solid #c0c8b4;padding:32px 0;align-items:center}.project-index>a:last-child{border-bottom:1px solid #c0c8b4}.index-number{font-size:10px;color:#89937e;align-self:start;padding-top:10px}.project-index h2{font-size:36px;line-height:1.2;transition:color .2s}.project-index p{font-size:12px;color:#78846b;margin-top:13px;max-width:300px;line-height:1.7}.project-index a.is-active h2{color:#778a60}.index-thumb{display:none}.project-index a>.studio-icon{transition:transform .3s}.project-index a:hover>.studio-icon{transform:translate(3px,-3px)}
.immersive-option{background:#30382d;color:var(--paper)}.immersive-heading{display:grid;grid-template-columns:1fr auto;align-items:end;gap:0 35px;margin-bottom:40px}.immersive-heading .section-kicker{grid-column:1/-1;color:#c0c9b4}.immersive-heading .all-projects{border-color:#85917a}.immersive-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.immersive-card{position:relative;display:block;overflow:hidden;isolation:isolate;min-height:440px}.immersive-card-0{grid-column:1/-1;min-height:560px}.immersive-card>img{position:absolute;inset:0;height:100%;width:100%;object-fit:cover;transition:transform .8s}.immersive-card::after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#111b12b8,transparent 75%);z-index:0}.immersive-caption{position:absolute;bottom:28px;left:30px;right:30px;z-index:1}.immersive-caption>span{font-size:8px;letter-spacing:1.8px;display:block;margin-bottom:14px}.immersive-caption h2{font-size:42px;letter-spacing:-1.4px;line-height:1.2}.immersive-card-0 h2{font-size:64px}.immersive-bottom{display:flex;gap:30px;align-items:end;justify-content:space-between;margin-top:14px}.immersive-bottom p{font-size:12px;max-width:320px;line-height:1.7;color:#e2e7da}.immersive-bottom .project-open{flex-shrink:0}.design-panel :global(.studio-icon){width:18px;height:18px;flex-shrink:0}
@media(max-width:800px){.design-picker{padding:23px 20px 20px}.picker-heading{font-size:8px;display:block;line-height:1.8}.picker-heading>span{display:block;margin-top:8px}.option-tabs{gap:7px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.option-tabs button{padding:11px 9px;font-size:10px;gap:8px;line-height:1.5;align-items:flex-start;flex-direction:column;text-align:left}.option-description{font-size:11px;line-height:1.7;min-height:38px}.design-panel{padding:40px 0 50px}.option-wrap{width:calc(100% - 40px)}.section-kicker{font-size:8px;letter-spacing:1.3px;margin-bottom:18px}.design-panel h1{font-size:40px;letter-spacing:-1.8px;text-wrap:balance;text-align:center;line-height:1.13}.editorial-heading{display:block;text-align:center;margin-bottom:28px}.all-projects{margin-top:20px;font-size:11px;gap:25px}.editorial-grid{grid-template-columns:1fr 1fr;gap:27px 14px}.editorial-card-0{grid-column:1/-1;grid-row:1}.editorial-card-1{grid-column:1;grid-row:2}.editorial-card-2{grid-column:2;grid-row:2}.editorial-card-0 .editorial-photo img{height:auto;aspect-ratio:4/3}.editorial-photo img{height:auto;aspect-ratio:4/5}.editorial-caption{gap:9px;align-items:baseline;margin-top:13px}.editorial-caption h2{font-size:21px;line-height:1.2;letter-spacing:-.7px}.editorial-card-0 h2{font-size:30px}.caption-action{display:none}.editorial-caption>span:first-child{font-size:8px}.project-subtitle{font-size:11px;margin-left:22px;line-height:1.7}.editorial-photo .project-open{right:10px;bottom:10px;width:34px;height:34px}.index-heading{display:block;text-align:center;margin-bottom:30px}.index-heading>.section-kicker{max-width:none}.index-heading br{display:none}.index-heading h1{max-width:300px;margin:auto}.index-composition{display:block}.index-preview{display:none}.project-index>a{grid-template-columns:18px 1fr 90px;gap:12px;padding:24px 0}.project-index h2{font-size:26px;color:var(--ink)!important}.project-index p{font-size:10px;margin-top:10px;line-height:1.6}.project-index a>:global(.studio-icon){display:none}.index-thumb{display:block;width:90px;height:115px}.index-number{font-size:8px;padding-top:5px}.immersive-heading{display:block;text-align:center;margin-bottom:28px}.immersive-grid{grid-template-columns:1fr;gap:16px}.immersive-card,.immersive-card-0{grid-column:1;min-height:370px}.immersive-card-0{min-height:450px}.immersive-caption{left:22px;right:22px;bottom:24px}.immersive-caption h2,.immersive-card-0 h2{font-size:38px}.immersive-bottom{gap:15px}.immersive-bottom p{font-size:11px;max-width:220px}.immersive-bottom .project-open{width:38px;height:38px}}
@media(max-width:360px){.design-panel h1{font-size:35px}.editorial-caption h2{font-size:18px}.project-index>a{grid-template-columns:15px 1fr 75px;gap:10px}.index-thumb{width:75px;height:100px}.project-index h2{font-size:23px}}
@media(prefers-reduced-motion:reduce){.editorial-photo img,.immersive-card>img,.index-preview img,.project-index h2,.project-index a>.studio-icon{transition:none}.editorial-card:hover img,.immersive-card:hover>img{transform:none}}
</style>
</SiteLayout>
