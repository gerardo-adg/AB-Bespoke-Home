---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import InnerFeature from '../components/InnerFeature.astro';
import source from '../data/original.json';
export function getStaticPaths(){return Object.keys(source).filter(r=>r!=='/').map(route=>({params:{slug:route.slice(1)},props:{route}}));}
const {route}=Astro.props;
const page=(source as any)[route];
const isService=route.startsWith('/services/');
const isProject=route.startsWith('/projects/');
const portfolio=source['/projects'].projects;
const project=portfolio.find(p=>p.href===route);
const heading=project?.name || page.texts[0]?.replace(/<[^>]*>/g,'') || 'AB Bespoke Home';
const heroImage=isProject?page.images[0]?.url:route==='/meet-the-team'?'/images/team0.jpg':route==='/services/bathrooms'?'/images/5.jpg':route==='/services/additions'||route==='/services/new-construction'?'/images/2.jpg':route==='/signature-guarantee'?'/images/1.jpg':page.images[0]?.url||'/images/6.jpg';
const firstTitle=(page.blocks[0]?.match(/<h[1-6][^>]*>(.*?)<\/h[1-6]>/s)?.[1] || heading).replace(/<[^>]+>/g,'');
const leftover=page.blocks[0]?.replace(/<h[1-6][^>]*>.*?<\/h[1-6]>/s,'')||'';
const bespokeLayout=isProject || ['/meet-the-team','/our-process','/signature-guarantee'].includes(route);
const isPortfolio=route==='/projects';
const isContact=route==='/contact';
const galleryImages=isProject?page.images:[];
const chunks=(html:string)=>html.split(/(?=<h2[ >])/).filter(Boolean);
---
<SiteLayout title={page.title}>
{isPortfolio ? <>
<section class="page-title wrap reveal"><p class="eyebrow">AB BESPOKE HOME</p><h1>Featured Projects</h1></section><section class="portfolio wrap">{portfolio.map((p,i)=><a class="project reveal" href={p.href}><div class="photo"><img src={(source as any)[p.href]?.images[0]?.url || '/images/2.jpg'} alt={`${p.name} project by AB Bespoke Home`} loading={i===0?'eager':'lazy'}/><span class="round"><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></div><div class="caption"><h2>{p.name}</h2><span>VIEW PROJECT <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></div></a>)}</section>
</> : isContact ? <>
<section class="page-title wrap reveal"><p class="eyebrow">AB BESPOKE HOME</p><h1>{page.texts[0]}</h1></section><section class="contact-layout wrap"><aside class="contact-aside"><img src="/images/5.jpg" alt="AB Bespoke Home bathroom detail" loading="eager"/><div class="prose" set:html={page.blocks[1]}/></aside><form id="inquiry" name="project-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you"><input type="hidden" name="form-name" value="project-inquiry"/><div hidden><label>Leave this empty<input name="bot-field" tabindex="-1" autocomplete="off"/></label></div><fieldset><legend>Name <span>(required)</span></legend><div class="field-row"><label>First Name<input name="First Name" autocomplete="given-name" required/></label><label>Last Name<input name="Last Name" autocomplete="family-name" required/></label></div></fieldset><label>Email <span>(required)</span><input type="email" name="Email" autocomplete="email" required/></label><fieldset><legend>Address <span>(required)</span></legend><label>Address 1<input name="Address 1" autocomplete="address-line1" required/></label><label>Address 2<input name="Address 2" autocomplete="address-line2"/></label><div class="field-row"><label>City<input name="City" autocomplete="address-level2" required/></label><label>State/Province<input name="State" autocomplete="address-level1" required/></label></div><div class="field-row"><label>Zip/Postal Code<input name="ZIP" autocomplete="postal-code" required/></label><label>Country<input name="Country" autocomplete="country-name" required/></label></div></fieldset><label for="message">Message <span>(required)</span></label><p id="message-help" class="field-help">{page.form.fields.find((f:any)=>f.type==='textarea').description}</p><textarea id="message" name="Message" rows="8" required aria-describedby="message-help" placeholder={page.form.fields.find((f:any)=>f.type==='textarea').placeholder}></textarea><button class="button dark" type="submit">{page.form.button} <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></button><p id="form-status" role="status"></p></form></section>
</> : bespokeLayout ? <InnerFeature route={route}/> : <>
<section class="inner-hero wrap"><div class="reveal"><p class="eyebrow">{isProject?'FEATURED PROJECTS':'AB BESPOKE HOME'}</p><h1>{isProject?project?.name:firstTitle}</h1>{isService && <div class="inner-actions"><a class="button dark" href="/contact">Get A Free Design Consult <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a><a class="text-link" href="/projects">View Our Work <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></div>}{isProject && <a class="text-link" href="/projects">Featured Projects <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a>}</div><img src={heroImage} alt={isProject?`${project?.name} project by AB Bespoke Home`:'AB Bespoke Home'} fetchpriority="high"/></section>
{isService ? <>
<nav class="page-jumps wrap" aria-label="On this page"><a href="#expect">What to Expect</a><a href="#service-detail">The Details</a><a href="/our-process">Our Process <span aria-hidden="true">↗</span></a></nav><section id="expect" class="wrap service-expect"><div class="section-heading reveal"><h2>{page.texts[2]}</h2><p>{page.texts[3]}</p></div><div class="expect-grid">{[4,6,8,10].map((i,n)=><details class="expect-item" name="expectations" open={n===0}><summary><span class="detail-index">0{n+1}</span><h3>{page.texts[i+1]}</h3><span class="detail-toggle" aria-hidden="true">＋</span></summary><p>{page.texts[i]}</p></details>)}</div></section><section class="statement"><div class="wrap reveal"><h2>{page.texts[12]}</h2></div></section><section id="service-detail" class="wrap service-editorial">{[13,15,17,19].map((i,n)=><details class="service-scene" name="service-scenes" open={n===0}><summary><span class="eyebrow">0{n+1}</span><h2>{page.texts[i]}</h2><span class="detail-toggle" aria-hidden="true">＋</span></summary><div class="scene-content"><div class="prose reveal"><p>{page.texts[i+1]}</p></div><img src={route==='/services/bathrooms' ? (source['/projects/campus-commons-bathroom-remodels-in-10-days'].images[n]?.url || '/images/5.jpg') : route==='/services/kitchen' ? (page.images[n]?.url || '/images/4.jpg') : route==='/services/remodels' ? (source['/projects/surita-mariemont-full-home-remodel'].images[n+1]?.url || '/images/3.jpg') : ['/images/2.jpg','/images/6.jpg','/images/4.jpg','/images/1.jpg'][n]} alt="AB Bespoke Home project detail" loading="lazy"/></div></details>)}</section><section class="wrap service-details"><h2>{page.texts[21]}</h2><article class="prose" set:html={page.blocks[22]}/><div class="related"><h3>{page.texts[23]}</h3><a class="text-link" href="/our-services">All Services <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></a><a class="text-link" href="/our-process">Our Process <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></section>
</> : <>
{isProject && <section class="project-gallery wrap" aria-label={`${project?.name} photo gallery`}>{galleryImages.slice(1).map((im:any,i:number)=><button class="project reveal" data-image={im.url} data-title={`${project?.name} · ${i+2}`} aria-label={`Enlarge ${project?.name} photo ${i+2}`}><div class="photo"><img src={im.url} alt={im.alt||`${project?.name} project, photo ${i+2}`} loading="lazy"/><span class="round"><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></div></button>)}</section>}
<section class:list={['editorial wrap',isProject&&'project-story']}><aside><p class="eyebrow">{isProject?project?.name:'AB BESPOKE HOME'}</p><a href="/contact" class="text-link">Start Building <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></a></aside><div class="prose">{!isProject && leftover.trim() && <div set:html={leftover}/>} {page.blocks.slice(1).flatMap((block:string)=>chunks(block)).map((html:string)=><div class="editorial-chunk" set:html={html}/>)}</div></section>
{isProject && <div class="wrap related project-next">{portfolio.filter(p=>p.href!==route).map(p=><a class="text-link" href={p.href}>{p.name} <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></a>)}</div>}
</>}
</>}
{!isContact && <ContactCTA/>}
</SiteLayout>
