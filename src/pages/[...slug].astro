---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import InnerFeature from '../components/InnerFeature.astro';
import StudioPage from '../components/StudioPage.astro';
import source from '../data/original.json';
export function getStaticPaths(){return Object.keys(source).filter(r=>r!=='/').map(route=>({params:{slug:route.slice(1)},props:{route}}));}
const {route}=Astro.props;
const page=(source as any)[route];
const isContact=route==='/contact';
const bespokeLayout=route.startsWith('/projects/') || ['/meet-the-team','/our-process','/signature-guarantee'].includes(route);
---
<SiteLayout title={page.title}>
{isContact ? <div class="studio studio-contact">
<section class="page-title wrap reveal"><p class="eyebrow">AB BESPOKE HOME</p><h1>{page.texts[0]}</h1></section><section class="contact-layout wrap"><aside class="contact-aside"><img src="/images/5.jpg" alt="AB Bespoke Home bathroom detail" loading="eager"/><div class="prose" set:html={page.blocks[1]}/></aside><form id="inquiry" name="project-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you"><input type="hidden" name="form-name" value="project-inquiry"/><div hidden><label>Leave this empty<input name="bot-field" tabindex="-1" autocomplete="off"/></label></div><fieldset><legend>Name <span>(required)</span></legend><div class="field-row"><label>First Name<input name="First Name" autocomplete="given-name" required/></label><label>Last Name<input name="Last Name" autocomplete="family-name" required/></label></div></fieldset><label>Email <span>(required)</span><input type="email" name="Email" autocomplete="email" required/></label><fieldset><legend>Address <span>(required)</span></legend><label>Address 1<input name="Address 1" autocomplete="address-line1" required/></label><label>Address 2<input name="Address 2" autocomplete="address-line2"/></label><div class="field-row"><label>City<input name="City" autocomplete="address-level2" required/></label><label>State/Province<input name="State" autocomplete="address-level1" required/></label></div><div class="field-row"><label>Zip/Postal Code<input name="ZIP" autocomplete="postal-code" required/></label><label>Country<input name="Country" autocomplete="country-name" required/></label></div></fieldset><label for="message">Message <span>(required)</span></label><p id="message-help" class="field-help">{page.form.fields.find((f:any)=>f.type==='textarea').description}</p><textarea id="message" name="Message" rows="8" required aria-describedby="message-help" placeholder={page.form.fields.find((f:any)=>f.type==='textarea').placeholder}></textarea><button class="button dark" type="submit">{page.form.button} <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></button><p id="form-status" role="status"></p></form></section>
</div> : bespokeLayout ? <InnerFeature route={route}/> : <StudioPage route={route}/>}
{!isContact && <ContactCTA/>}
</SiteLayout>
