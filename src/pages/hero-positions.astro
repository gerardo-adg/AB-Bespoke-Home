---
const options=[['balanced','A / Balanced lift','Higher than the current layout, with more space above the headline.'],['upper','B / Upper third','My recommendation: a stronger opening with room for the kitchen below.'],['high','C / High placement','The most immediate headline, sitting closer to the navigation.']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><title>Mobile Hero Positions | AB Bespoke Home</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet"/></head><body><div class="review-top"><div><a href="/">AB BESPOKE HOME</a><h1>Mobile headline placement</h1></div><p>The same headline, photo, and buttons.<br/>Three higher placements to compare.</p></div><div class="mobile-switch" role="tablist" aria-label="Headline placement">{options.map(([key,label],i)=><button type="button" role="tab" aria-selected={i===1?'true':'false'} aria-controls={`placement-${key}`} id={`tab-${key}`} tabindex={i===1?0:-1} data-choice={key}>{label}</button>)}</div><main>{options.map(([key,label,description])=><section class:list={['option',key==='upper'&&'recommended']} data-placement={key} id={`placement-${key}`} aria-labelledby={`label-${key}`}><div class="option-heading"><h2 id={`label-${key}`}>{label}</h2>{key==='upper'&&<span>RECOMMENDED</span>}</div><iframe title={label} src={`/hero-study/?position=${key}`} loading="eager"></iframe><p class="description">{description}</p></section>)}</main><script>
const choices=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-choice]'));
const select=(key:string,focus=false)=>{document.querySelectorAll<HTMLElement>('[data-placement]').forEach(p=>p.classList.toggle('selected',p.dataset.placement===key));choices.forEach(b=>{const current=b.dataset.choice===key;b.setAttribute('aria-selected',String(current));b.tabIndex=current?0:-1;if(current&&focus)b.focus()});};
choices.forEach((b,i)=>{b.addEventListener('click',()=>select(b.dataset.choice!));b.addEventListener('keydown',e=>{let n=i;if(e.key==='ArrowRight')n=(i+1)%choices.length;else if(e.key==='ArrowLeft')n=(i+choices.length-1)%choices.length;else return;e.preventDefault();select(choices[n].dataset.choice!,true)})});select('upper');
</script><style>
*{box-sizing:border-box}body{margin:0;background:#e4e6dd;color:#30362c;font-family:'DM Sans',sans-serif}.review-top{max-width:1240px;margin:0 auto;padding:26px 0 20px;display:flex;align-items:center;justify-content:space-between;gap:25px}.review-top a{font-size:9px;letter-spacing:1.7px;color:inherit;text-decoration:none}h1{font-size:25px;letter-spacing:-.7px;font-weight:400;margin:9px 0 0}.review-top>p{font-size:12px;line-height:1.8;color:#6e7665;margin:0}main{max-width:1240px;margin:auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding-bottom:30px}.option-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:15px 0}h2{font-size:13px;font-weight:500;margin:0}.option-heading>span{font-size:7px;letter-spacing:1px;border:1px solid #a5b197;padding:5px 7px}.option iframe{display:block;width:100%;height:780px;border:0;background:#30362c;box-shadow:0 8px 24px #25301c10}.recommended iframe{outline:2px solid #879875;outline-offset:4px}.description{font-size:11px;line-height:1.8;color:#6b7561;margin:16px 0 0;max-width:340px}.mobile-switch{display:none}
@media(max-width:1280px) and (min-width:801px){.review-top,main{margin-inline:25px}.option iframe{height:740px}main{gap:20px}}
@media(max-width:800px){.review-top{display:block;padding:25px 20px 20px}.review-top>p{margin-top:15px;font-size:12px}h1{font-size:25px}.mobile-switch{display:flex;gap:8px;margin:0 20px 14px}.mobile-switch button{flex:1;min-height:50px;padding:10px 8px;background:transparent;border:1px solid #b0b9a5;font:inherit;font-size:10px;color:inherit;cursor:pointer}.mobile-switch button[aria-selected=true]{background:#30362c;color:#f5f3ed;border-color:#30362c}main{display:block;margin:0 20px 25px}.option{display:none}.option.selected{display:block}.option iframe{height:780px}.description{max-width:none}.recommended iframe{outline-offset:3px}}
</style></body></html>
