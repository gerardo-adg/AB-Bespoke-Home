---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import BrandSeal from '../components/BrandSeal.astro';
import Reviews from '../components/Reviews.astro';
import source from '../data/original.json';
const home=source['/'];
const projects=source['/projects'].projects;
const selected=[projects[0],projects[1],projects[3]];
const projectImage=(href:string)=>(source as any)[href]?.images[0]?.url || '/images/2.jpg';
---
<SiteLayout title={home.title} home>
<section class="hero hero-left"><img class="hero-image" src="/images/4.jpg" alt="AB Bespoke kitchen with blue cabinetry and brass fixtures" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><h1>Your Home,<br/>Built to Suit</h1><div class="hero-bottom"><p>{home.texts[1]}</p><div class="hero-actions"><a class="button light" href="/contact">Start Building <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a><a class="hero-secondary" href="/projects">View Our Work <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></div></div></div><a class="scroll" href="#intro"><span>AB BESPOKE HOME</span><span>↓</span></a></section>
<section id="intro" class="intro wrap"><p class="eyebrow">AB BESPOKE HOME</p><div><h2>{home.texts[2]}</h2><div class="prose" set:html={home.blocks[3]} /></div></section>
<section class="work wrap"><div class="section-heading"><h2>Featured Projects</h2><a class="text-link" href="/projects">View Our Work <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></div><div class="project-grid">{selected.map((p,i)=><a class:list={['project',i===0?'wide':'narrow']} href={p.href}><div class="photo"><img src={projectImage(p.href)} loading="lazy" alt={`${p.name} project by AB Bespoke Home`}/><span class="round"><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></div><div class="caption"><h3>{p.name}</h3></div></a>)}</div></section>
<section id="experience" class="home-experience layered-experience"><div class="wrap experience-grid"><div class="layered-photo-pair"><figure class="layer-photo layer-photo-main reveal"><img src="/images/2.jpg" alt="Renovated Sacramento home by AB Bespoke Home" loading="lazy"/></figure><figure class="layer-photo layer-photo-detail reveal" data-reveal-delay="120"><img src="/images/1.jpg" alt="Custom woodwork detail by AB Bespoke Home" loading="lazy"/></figure><span class="photo-pair-rule section-rule reveal" aria-hidden="true"></span></div><div class="prose experience-copy reveal" set:html={home.blocks[4]}/></div></section>
<section id="reassurance" class="reassurance layered-reassurance"><BrandSeal/><div class="wrap reassurance-content reveal"><p class="eyebrow">{home.texts[5]}</p><h2>{home.texts[6]}</h2><p>{home.texts[7]}</p><a class="text-link" href="/contact">Start Building <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a><span class="reassurance-rule section-rule reveal" aria-hidden="true"></span></div></section>
<Reviews/>
<section class="services"><div class="wrap"><div class="section-heading"><h2>{home.texts[8]}</h2><a class="text-link" href="/our-services">All Services <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></div><div class="home-service-grid">{home.services.map((service,i)=><article class="reveal"><span class="number">0{i+1}</span><h3><a href={service.href}>{service.title} <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></h3><div class="prose" set:html={service.html}/></article>)}</div></div></section>
<section class="process wrap"><div class="section-heading"><h2>{home.texts[9]}</h2><a class="text-link" href="/our-process">Our Process <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></div><div class="prose home-process reveal" set:html={home.blocks[10]}/></section>
<ContactCTA/>
</SiteLayout>
